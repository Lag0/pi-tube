{
  "name": "pi-tube",
  "version": "0.2.0",
  "description": "Bun + TypeScript CLI foundation for deterministic media-intake workflows",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "pi-tube": "./bin/pi-tube.ts"
  },
  "scripts": {
    "pi-tube": "bun run --bun bin/pi-tube.ts",
    "start": "bun run --bun bin/pi-tube.ts",
    "test": "bun test",
    "verify:fixtures": "bun run --bun scripts/verify-fixtures.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
